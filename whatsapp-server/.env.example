# ─────────────────────────────────────────────────────────────
# WhatsApp bridge configuration (POS Marketing module)
# ─────────────────────────────────────────────────────────────

# Port the bridge listens on
PORT=3001

# Secret token. PHP sends this in the X-Api-Token header on every request.
# CHANGE THIS to any long random string.
API_TOKEN=change-this-to-a-long-random-string

# Where the WhatsApp login session files are stored (relative to this folder)
SESSION_DIR=session

# Set to 1 to print the QR code in the terminal instead of the logo
# (still stored, the API keeps serving it too)

# ─────────────────────────────────────────────────────────────────────────────
# Agent mode - the reverse connection. Fill these in ONLY if the POS is on
# shared hosting / cPanel and cannot be given a public address to call.
#
# With these set, run `npm run agent` INSTEAD of `npm start`. The bridge then
# calls the POS rather than the other way round, so no Cloudflare tunnel, no DNS
# change and no public address are needed - which is what makes it usable on a
# host that will not give you one.
#
# See whatsapp-server/AGENT-MODE.md before changing anything here.
# ─────────────────────────────────────────────────────────────────────────────

# The POS address, with no trailing slash and no /admin at the end.
#   live site : https://smartercollection.shop
#   local XAMPP: http://localhost/admin
POS_URL=

# Shared secret. Must be the SAME value as the POS's agent token, which is typed
# into the WhatsApp Inbox page under "Bridge setup". It authenticates calls in
# the opposite direction to API_TOKEN: that one lets the POS call the bridge,
# this one lets the bridge call the POS.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_TOKEN=

# Optional. How often to call the POS when there is nothing to send, in
# milliseconds. 2500 is the default and is deliberately unhurried.
POLL_MS=2500

# Optional. Identifies this bridge in the POS. Defaults to the computer's
# hostname, which is enough to tell two shop computers apart. Set it only if the
# hostname is something unhelpful or likely to change.
# AGENT_ID=shop-pc-1
