# ============================================================
#  Nothing in this folder is meant to be served over HTTP.
#
#  The POS app talks to the bridge over http://127.0.0.1:3001,
#  which bypasses Apache entirely. So this directory can be closed
#  completely - and must be, because it holds the WhatsApp login
#  credentials and the API token in .env.
#
#  Denying everything (rather than listing files to block) means
#  anything added here later is protected by default.
# ============================================================

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
